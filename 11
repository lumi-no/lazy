#include <iostream>

using namespace std;

class LazyRange
{
private:
    long long current;
    long long end;

public:
    LazyRange(long long start, long long end)
    {
        current = start;
        this->end = end;
    }

    bool hasNext()
    {
        return current < end;
    }

    long long next()
    {
        return current++;
    }
};

int main()
{
    // range(10**9)
    LazyRange data(0, 1000000000);

    for (int i = 0; i < 10; i++)
    {
        if (data.hasNext())
        {
            cout << data.next()
                 << " ";
        }
    }

    return 0;
}
